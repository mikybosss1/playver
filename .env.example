# Copy to .env.local and fill in real values for local development.
# See ARCHITECTURE.md and README.md for the full environments overview
# (local / staging / production).

# --- Database (Neon Postgres connection string) ---
DATABASE_URL=

# --- Better Auth ---
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=

# Auto-provided by Vercel on every deployment — never set this yourself.
# VERCEL_URL=

# --- Google OAuth (sign-in with Google) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- App base URL (used in email links + Stripe checkout redirect URLs) ---
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# --- Email (Resend) ---
RESEND_API_KEY=

# Set to "log" to no-op email sending (logs instead of calling Resend) —
# used on staging so testing never emails real people. Leave unset for
# local dev and production.
# EMAIL_MODE=log

# --- Stripe ---
# Always sk_test_... outside of real production — see docs/stripe-testing.md.
STRIPE_SECRET_KEY=
# Endpoint-specific — from `stripe listen` locally, or the Stripe Dashboard
# webhook endpoint's signing secret in staging/production.
STRIPE_WEBHOOK_SECRET=

# --- UploadThing (image uploads) ---
UPLOADTHING_TOKEN=

# --- Cron (optional) ---
# If unset, /api/cron/upcoming-events runs unauthenticated. Only relevant
# on Production Vercel deployments — Vercel Cron Jobs never fire on
# Preview/branch deployments (e.g. staging) regardless of this var.
# CRON_SECRET=

# --- Local-only convenience vars, never set in Vercel ---
# Read directly by scripts/*.mjs (not by the app itself):
#   PROD_DATABASE_URL    — lets migrate-*.mjs also run against prod
#   OLD_DATABASE_URL     — source DB for migrate-from-old-db.mjs
#   STAGING_DATABASE_URL — target for scripts/run-staging-migrations.mjs
